# --- Required ---
# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Telegram numeric user id of the admin (get it from /whoami or @userinfobot).
# This account is auto-approved and is the sole approver of other users.
ADMIN_TELEGRAM_ID=123456789

# --- Optional (defaults shown) ---
# Language of the bot's OWN fixed strings (command replies, errors, previews, help).
# The assistant's generated replies always mirror the user's language regardless;
# this only controls the hardcoded UI text. 'en' is the default; set 'ru' to get the
# original Russian wording verbatim. One of: en|ru.
BOT_LOCALE=en
ANTHROPIC_MODEL=claude-sonnet-5
# Speech-to-text for voice messages (OpenAI audio API). Without a key, voice
# notes are ignored. https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Priming text sent to the transcription API so it spells domain words (траты,
# amounts, currencies, names) right. Has a sensible RU default; set empty to disable.
# OPENAI_TRANSCRIBE_PROMPT=Голосовое сообщение боту-секретарю про траты и расходы...
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional "humorizer": after Anthropic answers, a cheap OpenAI model rewrites
# the TONE of plain-chat replies to be funnier. Tone only — facts/numbers/links
# are preserved, and factual/tool answers (expenses, surf, web search,
# reminders) are never touched. Needs OPENAI_API_KEY. Off by default.
ENABLE_HUMOR=false
OPENAI_HUMOR_MODEL=gpt-5.5
# gpt-5-family models reason before answering by default, which makes the
# humorizer/quip pass feel far slower than Claude. 'low' keeps the pass quick
# while still letting the model do a real rewrite ('minimal' turned out lazy —
# near-verbatim echoes). Use 'none' to omit the field for non-reasoning models
# (e.g. gpt-4o-mini) that reject it. One of: none|minimal|low|medium|high.
OPENAI_REASONING_EFFORT=low
# Hard cap (ms) on a single humorizer/quip OpenAI call, so a slow tone pass can't
# hold a reply hostage (falls back to the original text / skips the joke).
OPENAI_HUMOR_TIMEOUT_MS=20000
# Optional "expense quip": after an expense is confirmed, a cheap OpenAI model
# appends a short joke to the bottom of the "✅ Записано" message. It's added
# after the write, so it's display-only and can't corrupt amounts/names.
# Needs OPENAI_API_KEY; reuses OPENAI_HUMOR_MODEL. OFF by default (opt-in flavor).
ENABLE_EXPENSE_QUIP=false
# Default persona (voice/style) for chats that haven't picked one with /style.
# A preset id from src/persona/presets.ts: neutral | chill | formal (add your own
# there). 'neutral' is a plain, concise secretary; 'chill' is the laid-back voice.
DEFAULT_PERSONA=neutral
DEFAULT_CURRENCY=EUR
DATABASE_PATH=./data/bot.sqlite
LOG_LEVEL=info
# How long a pending (un-confirmed) expense preview stays valid, in minutes.
PENDING_TTL_MINUTES=30
# How many recent conversation turns per chat to feed the model as context.
CONVERSATION_HISTORY_LIMIT=20
# Drop dialogue history older than this many hours, so an old off-topic session
# expires on its own instead of lingering in the bot's context.
CONVERSATION_HISTORY_MAX_AGE_HOURS=12
# Enable Claude web_search server tool (requires outbound internet on the host).
ENABLE_WEB_SEARCH=true
# Optional skill: surf_forecast tool (Open-Meteo marine/weather API; no key needed,
# but the host must allow outbound HTTPS to *.open-meteo.com). OFF by default — turn
# on if your chats care about wave forecasts.
ENABLE_SURF=false
# Spontaneous "chime-in": occasionally revive a long-quiet group chat on its own.
# A gimmick — OFF by default.
ENABLE_CHIME=false
# Fallback IANA timezone for reminders when a chat hasn't set one yet
# (the bot asks each chat for its timezone the first time a reminder is created).
DEFAULT_TIMEZONE=UTC
# Lexicon learning: passively buffer chat messages and, in batches, extract the
# slang / distorted word-forms the group uses so the bot picks up their lingo.
# View/reset per chat with /slang. OFF by default (only surfaces via the humorizer).
ENABLE_LEXICON=false
# Cheap model used only for the lexicon extraction batches (not the main chat).
ANTHROPIC_LEXICON_MODEL=claude-haiku-4-5-20251001
# Run an extraction batch once this many messages have buffered, or once the
# oldest buffered message is this many hours old — whichever comes first.
LEXICON_BATCH_SIZE=30
LEXICON_MAX_AGE_HOURS=24
# How many learned terms to feed back into the assistant's context.
LEXICON_MAX_TERMS=40
