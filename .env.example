# --- Required ---
# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
# Telegram numeric user id of the admin (get it from /whoami or @userinfobot).
# This account is auto-approved and is the sole approver of other users.
ADMIN_TELEGRAM_ID=123456789

# --- Optional (defaults shown) ---
ANTHROPIC_MODEL=claude-sonnet-5
# Speech-to-text for voice messages (OpenAI audio API). Without a key, voice
# notes are ignored. https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Priming text sent to the transcription API so it spells domain words (траты,
# amounts, currencies, names) right. Has a sensible RU default; set empty to disable.
# OPENAI_TRANSCRIBE_PROMPT=Голосовое сообщение боту-секретарю про траты и расходы...
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional "humorizer": after Anthropic answers, a cheap OpenAI model rewrites
# the TONE of plain-chat replies to be funnier. Tone only — facts/numbers/links
# are preserved, and factual/tool answers (expenses, surf, web search,
# reminders) are never touched. Needs OPENAI_API_KEY. Off by default.
ENABLE_HUMOR=false
OPENAI_HUMOR_MODEL=gpt-5.5
# gpt-5-family models reason before answering by default, which makes the
# humorizer/quip pass feel far slower than Claude. 'low' keeps the pass quick
# while still letting the model do a real rewrite ('minimal' turned out lazy —
# near-verbatim echoes). Use 'none' to omit the field for non-reasoning models
# (e.g. gpt-4o-mini) that reject it. One of: none|minimal|low|medium|high.
OPENAI_REASONING_EFFORT=low
# Hard cap (ms) on a single humorizer/quip OpenAI call, so a slow tone pass can't
# hold a reply hostage (falls back to the original text / skips the joke).
OPENAI_HUMOR_TIMEOUT_MS=20000
# Optional "expense quip": after an expense is confirmed, a cheap OpenAI model
# appends a short joke to the bottom of the "✅ Записано" message. It's added
# after the write, so it's display-only and can't corrupt amounts/names.
# Needs OPENAI_API_KEY; reuses OPENAI_HUMOR_MODEL. On by default.
ENABLE_EXPENSE_QUIP=true
DEFAULT_CURRENCY=EUR
DATABASE_PATH=./data/bot.sqlite
LOG_LEVEL=info
# How long a pending (un-confirmed) expense preview stays valid, in minutes.
PENDING_TTL_MINUTES=30
# How many recent conversation turns per chat to feed the model as context.
CONVERSATION_HISTORY_LIMIT=20
# Drop dialogue history older than this many hours, so an old off-topic session
# expires on its own instead of lingering in the bot's context.
CONVERSATION_HISTORY_MAX_AGE_HOURS=12
# Rolling per-chat log of everything said in a chat — including the messages the
# bot never replies to — so it can recap them on request («перескажи, что было в
# последних 200 сообщениях»). Bounded by count and age; inspect/wipe per chat with
# the admin command /chatlog <chatId> [clear]. false = nothing is recorded.
ENABLE_CHAT_LOG=true
CHAT_LOG_KEEP_PER_CHAT=4000
CHAT_LOG_RETENTION_DAYS=30
# How many messages a recap reads by default and the hard ceiling for one recap.
SUMMARY_DEFAULT_MESSAGES=200
SUMMARY_MAX_MESSAGES=1000
# How much transcript may reach the main model VERBATIM. A bigger window (e.g.
# «перескажи последние 500 сообщений») is handled in two tiers instead of being cut:
# a cheap model compresses the older part into notes, the newest slice stays
# word-for-word. chunk × max chunks is how far back one recap can reach.
SUMMARY_CHAR_BUDGET=14000
ENABLE_SUMMARY_CONDENSE=true
ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5-20251001
SUMMARY_TAIL_CHAR_BUDGET=6000
SUMMARY_CONDENSE_CHUNK_CHARS=20000
SUMMARY_CONDENSE_MAX_CHUNKS=8
# Enable Claude web_search server tool (requires outbound internet on the host).
ENABLE_WEB_SEARCH=true
# Enable the surf_forecast tool (Open-Meteo marine/weather API; no key needed,
# but the host must allow outbound HTTPS to *.open-meteo.com).
ENABLE_SURF=true
# Flight tools: «проверь статус рейса K6829» (flight_status) and «следи за
# рейсом, напиши если отменят/перенесут» (watch_flight — the bot polls the
# flight itself and posts on cancellation / moved times / takeoff / landing;
# manage with /flight). Needs ONE of the two provider keys below — without a key
# the tools are simply not offered to the model.
ENABLE_FLIGHTS=true
# PREFERRED: FlightAware AeroAPI (https://www.flightaware.com/commercial/aeroapi/)
# — pay-per-query, no monthly minimum, and the Personal tier includes $5/month
# of free usage (a few watched flights a week ≈ well under it). Takes precedence
# over aviationstack when both keys are set.
# AEROAPI_KEY=...
AEROAPI_BASE_URL=https://aeroapi.flightaware.com/aeroapi
# Fallback: aviationstack.com. The free key works, but mind its quota (~100
# requests/month): every watch poll is one request (the default hourly pace is
# ~24/day). The free plan is HTTP-only — switch the base URL to https:// on a
# paid plan.
# AVIATIONSTACK_API_KEY=...
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1
FLIGHT_WATCH_INTERVAL_MINUTES=60
FLIGHT_WATCH_MAX_PER_CHAT=4
FLIGHT_WATCH_EXPIRES_HOURS=48
# Departure/arrival moves smaller than this many minutes are jitter, not news.
FLIGHT_DELAY_NOTIFY_MINUTES=10
# Google Calendar («календарь»): a chat links its calendar by the SECRET iCal
# address (Google Calendar → настройки календаря → «Секретный адрес в формате
# iCal») via /calendar add <ссылка>. The bot caches upcoming events, sends the
# smart reminders (evening digest about tomorrow, morning digest about today,
# a ping shortly before each event) and answers «что у меня завтра» with the
# calendar_events tool. Strictly per chat; the secret link is never echoed back.
ENABLE_CALENDAR=true
CALENDAR_FETCH_MINUTES=30
CALENDAR_HORIZON_DAYS=14
CALENDAR_EVENING_HOUR=21
CALENDAR_MORNING_HOUR=8
# An event starting before this local hour counts as EARLY — the evening digest
# leans into prep advice («собери вещи и закажи такси с вечера»).
CALENDAR_EARLY_HOUR=10
CALENDAR_SOON_MINUTES=60
CALENDAR_MAX_PER_CHAT=4
# Enable the Dota knowledge base: a nightly crawl of Valve's keyless datafeed
# (~550 requests, parked at DOTA_SYNC_HOUR_UTC) into SQLite, read by the
# dota_lookup tool in dota-mode chats. Needs outbound HTTPS to www.dota2.com and
# raw.githubusercontent.com; no API key.
ENABLE_DOTA=true
# Fallback IANA timezone for reminders when a chat hasn't set one yet
# (the bot asks each chat for its timezone the first time a reminder is created).
DEFAULT_TIMEZONE=UTC
# Lexicon learning: passively buffer chat messages and, in batches, extract the
# slang / distorted word-forms the group uses so the bot picks up their lingo.
# View/reset per chat with /slang.
ENABLE_LEXICON=true
# Cheap model used only for the lexicon extraction batches (not the main chat).
ANTHROPIC_LEXICON_MODEL=claude-haiku-4-5-20251001
# Run an extraction batch once this many messages have buffered, or once the
# oldest buffered message is this many hours old — whichever comes first.
LEXICON_BATCH_SIZE=30
LEXICON_MAX_AGE_HOURS=24
# How many learned terms to feed back into the assistant's context.
LEXICON_MAX_TERMS=40
# Apply that learned slang to the bot's replies. Unlike the humorizer this also
# covers the EXACT answers (tool results, money, chats with humour off): it only
# swaps words, and the result is discarded if any number/link/@username changed.
# Independent switch from ENABLE_HUMOR; needs OPENAI_API_KEY and reuses
# OPENAI_HUMOR_MODEL. Per chat: /slang on|off.
ENABLE_SLANG=true
